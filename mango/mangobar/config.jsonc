{
    "layer": "top",
    "height": 20,
    "buffer-scale": 1,
    "modules-left": [
        "workspaces",
        "layout",
        "window"
    ],
    "modules-center": [],
    "modules-right": [
        // Uncomment any of these to bring a module back:
        //"hideclients",
        //"tray",
        //"network",
        //"cpu",
        //"memory",
        "backlight",
        //"custom/power",
        //"clock#date",
        "pulseaudio",
        "battery",
        "clock#time"
    ],
    "workspaces": {
        "hide-empty": true,
        // "pinned": [1, 2],
        // "tag-names": ["1", "2", "3", "编", "网"],
        "overview-label": "OVERVIEW",
        "on-click": "activate",
        "on-click-right": "toggle",
        "scroll-interval": 100,
        "on-scroll-up": "mmsg dispatch viewtoleft_have_client",
        "on-scroll-down": "mmsg dispatch viewtoright_have_client"
    },
    "layout": {
        "format": "{}"
    },
    "window": {
        "format": "{}",
        // left: full screenshot to ~/Pictures/Screenshots (like Print); right: region to clipboard (like SHIFT+Print)
        "on-click": "grim ~/Pictures/Screenshots/$(date +%Y%m%d_%H%M%S).png && notify-send -t 2000 Screenshot \"Saved to ~/Pictures/Screenshots\"",
        "on-click-right": "g=$(slurp) && grim -g \"$g\" - | wl-copy && notify-send -t 2000 Screenshot \"Region copied to clipboard\""
    },
    "network": {
        "format": "󰈀 {ifname}",
        "format-alt": "↓{down} ↑{up}"
    },
    "hideclients": {
        "format": " {}"
    },
    "cpu": {
        "format": " {load}%"
    },
    "memory": {
        "format": " {}%"
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "icons": [
            "󰃞",
            "󰃟",
            "󰃝",
            "󰃝",
            "󰃠",
            "󰃠",
            "󰃠"
        ],
        "on-scroll-up": "brightnessctl -c backlight --min-value=1 set 2%+",
        "on-scroll-down": "brightnessctl -c backlight --min-value=1 set 2%-",
        "on-click": "fuzzel-settings brightness"
    },
    "pulseaudio": {
        "format": "{icon} {volume}% {bt}",
        "format-muted": "󰖁 {volume}% {bt}",
        "icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        "icon-bluetooth": "󰂯",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "fuzzel-settings sound",
        "on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "battery": {
        "format": "{icon} {percent}% {ac}",
        "icons": [
            "󰂎",
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        //"icon-charging": "󰂄",
        //"icon-full": "󰁹",
        "icon-ac": "",
        "hide-on-ac": true
    },
    "clock#date": {
        "format": " {:L%b%d·%A}"
    },
    "clock#time": {
        "format": " {:L%H:%M}"
    },
    "tray": {
        "icon-size": 14,
        "spacing": 8
    },
    "custom/power": {
        "format": "󰣇",
        "on-click": "fuzzel-settings power",
        // mako has no notification panel; this brings back the last dismissed one
        "on-click-right": "makoctl restore"
    },
    "custom/clock": {
        "exec": "date | cut -d ' ' -f 1",
        "interval": 5,
        "signal": 8
    }
}
