# ~/.config/mako/config — colors come from the wallpaper via wallust
# The color settings live in colors (generated from the wallust template
# ~/.config/wallust/templates/mako). Flat and square to match fuzzel/mangobar.

font=Terminess Nerd Font 12
width=360
height=160
margin=10
padding=12,16
border-size=1
border-radius=0
icons=0
max-visible=5
layer=overlay
anchor=top-right
default-timeout=6000
format=<b>%s</b>\n%b

# Must be outside any [criteria] section; the included file adds its own.
include=~/.config/mako/colors

[urgency=high]
default-timeout=0
